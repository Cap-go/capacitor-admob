{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Cap-go/.github:renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "androidx.core:core-ktx"
      ],
      "matchManagers": [
        "gradle"
      ],
      "allowedVersions": "<1.19.0"
    },
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "allowedVersions": "<9.6"
    }
  ]
}
